AI_PROVIDER=none
AI_API_KEY=
AI_API_BASE=
AI_MODEL=
QWEN_API_KEY=
QWEN_API_BASE=
QWEN_MODEL=
# For a public deployment, set the exact public hostname.
ALLOWED_HOST=
HOST=127.0.0.1
# Public accounts require a persistent data volume. Keep backups outside the web root.
# FANTASY3D_DATA_DIR=/var/data/fantasy3d
# Set only after verifying the volume survives a deployment/restart.
# BLINDBOX_PERSISTENT_STORAGE=true
# BLINDBOX_SIGNING_KEY=<generate-a-long-random-secret-in-the-host-dashboard>
# Public gift links remain disabled until HTTPS origin and persistent storage are configured.
# BLINDBOX_PUBLIC_ORIGIN=https://your-public-domain
BLINDBOX_SUPPORT_EMAIL=715341216@qq.com
# BLINDBOX_OPERATOR_NAME=<actual-operator-name>
# Backups: set BLINDBOX_BACKUP_PASSPHRASE only in a secure shell/secret manager.
# Never commit secrets or backup archives; preserve an env-supplied signing key separately.

# ===== 大模型（统一用阿里云百炼·千问，OpenAI 兼容接口）=====
# 6 个运营智能体（店长/调研/推荐/接待/订单/生产）
AI_PROVIDER=openai
AI_API_KEY=在这里填你的百炼API_KEY
# 注意：主模型 base 只写到 compatible-mode（程序会自动补 /v1/chat/completions）
AI_API_BASE=https://ws-dab1qd4falvbvd1g.cn-beijing.maas.aliyuncs.com/compatible-mode
AI_MODEL=qwen-flash

# 监管员（独立模型，与运营团队交叉制衡；base 要写到 /v1）
QWEN_API_KEY=在这里填你的百炼API_KEY
QWEN_API_BASE=https://ws-dab1qd4falvbvd1g.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ===== AI 防刷预算（超过自动走免费规则兜底，不再产生费用）=====
AI_DAILY_LIMIT=200
QWEN_DAILY_LIMIT=400
AI_IP_PER_MIN=6
AI_IP_PER_DAY=60
AI_MAX_USER_CHARS=2000
AI_MAX_CONTEXT_CHARS=6000

# 域名白名单：留空=对全网公开（默认，推荐）；只有想锁定单一域名时才填，如 fantasy3d-xxx.onrender.com
ALLOWED_HOST=
HOST=127.0.0.1

# ===== PayPal 收款（sandbox=测试，live=真实收款）=====
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=在这里填PayPal客户端ID
PAYPAL_CLIENT_SECRET=在这里填PayPal密钥
PAYPAL_ME=https://paypal.me/SUMINGHENG
PUBLIC_BASE_URL=
